# =====================================================================
# TELEGRAM BOT CONFIGURATION
# =====================================================================
# Bot token received from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Comma-separated Telegram User ID(s) authorized to use this bot.
# Obtain your ID by sending a message to @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_IDS=123456789

# =====================================================================
# OPENROUTER LLM CONFIGURATION
# =====================================================================
# API Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Models list (Primary -> Secondary -> Fallback, max 3 models for OpenRouter fallback array)
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,openrouter/free

# =====================================================================
# TIMEZONE CONFIGURATION
# =====================================================================
# Standard IANA Timezone string (e.g. Europe/Istanbul, America/New_York, UTC)
USER_TIMEZONE=Europe/Istanbul

# =====================================================================
# GOOGLE CALENDAR & TASKS AUTHENTICATION
# =====================================================================
# Method 1 (Local file path): Path to the downloaded service account JSON file
GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json

# Method 2 (Cloud Host / Render / Railway): Paste either the raw JSON string
# or the Base64-encoded JSON string of your service account credentials.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": ...}

# Optional: If using Google Workspace domain-wide delegation to impersonate a user
# GOOGLE_DELEGATED_EMAIL=user@yourdomain.com

# Optional (For Personal @gmail.com Google Tasks):
# If using a personal @gmail.com account where Service Accounts cannot access Tasks,
# run `python scripts/get_tasks_token.py` and supply these OAuth2 credentials:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# =====================================================================
# GOOGLE CALENDAR ROUTING MAP
# =====================================================================
# JSON dictionary mapping your category names to their respective Google Calendar IDs.
# Find Calendar IDs under Google Calendar Settings -> Integrate Calendar -> Calendar ID.
GOOGLE_CALENDAR_IDS={"Personal":"primary","Assistant work":"id_assistant@group.calendar.google.com","Quizzez / FInals":"id_quizzes@group.calendar.google.com","Self Studying":"id_selfstudy@group.calendar.google.com","Uni Classes":"id_uniclasses@group.calendar.google.com","University Studying":"id_unistudy@group.calendar.google.com","Completed Tasks":"id_completed@group.calendar.google.com"}

# Google Task list ID (defaults to "@default" for your main Google Tasks list)
GOOGLE_TASKS_LIST_ID=@default

# =====================================================================
# DATABASE & STORAGE
# =====================================================================
DATABASE_PATH=bot_scheduler.db
